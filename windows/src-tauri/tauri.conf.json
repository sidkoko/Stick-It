{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stick-It",
  "version": "0.1.0",
  "identifier": "com.siddhant.stickit.windows",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run copy-assets",
    "beforeBuildCommand": "npm run copy-assets"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
